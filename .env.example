# Development only. Supply separate credentials through hosting configuration.
GRID_ENVIRONMENT=development
GRID_DATABASE_URL=postgresql+psycopg://winddesk:winddesk_local@127.0.0.1:5432/winddesk
GRID_DEFAULT_CUTOFF_LOCAL=09:00
GRID_DB_POOL_SIZE=3
GRID_DB_MAX_OVERFLOW=2
GRID_FRONTEND_DIST=frontend/dist
GRID_BUILD_SHA=local
GRID_API_RATE_LIMIT_ENABLED=true
GRID_API_RATE_LIMIT_PER_MINUTE=120
GRID_API_MAX_INFLIGHT=64
GRID_WEB_WORKERS=1
GRID_RESPONSE_CACHE_MB=32
GRID_SOURCE_CACHE_MB=32
# Production: explicitly list the real domain(s), and use a separate read-only
# database login with a long random password and sslmode=verify-full.
GRID_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# API documentation defaults off in production, on in local development.
# GRID_ENABLE_API_DOCS=false
# Trust forwarding headers only when direct ingress is restricted to these
# known proxy addresses. Never use a wildcard or a caller-controlled network.
GRID_TRUSTED_PROXY_IPS=[]

# Local Docker PostgreSQL. Never reuse this development password in production.
POSTGRES_DB=winddesk
POSTGRES_USER=winddesk
POSTGRES_PASSWORD=winddesk_local
GRID_READER_USER=winddesk_reader
GRID_READER_PASSWORD=winddesk_local
# For native Python serving: seed --configure-reader as the operator, then set
# GRID_DATABASE_URL to this reader URL in the web process before starting serve.
GRID_READER_DATABASE_URL=postgresql+psycopg://winddesk_reader:winddesk_local@127.0.0.1:5432/winddesk
